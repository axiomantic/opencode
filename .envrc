# Workaround for macOS Tahoe ImageIO crash (SIGBUS at 0xbad4007).
# Homebrew image libs conflict with system ImageIO's PNG plugin.
# Known issue: https://github.com/tauri-apps/tauri/issues/7351
#              https://github.com/dotnet/sdk/issues/44425
# Only reliable fix is brew unlink. Env var approaches don't work because
# bun install during predev spawns shells that re-introduce /opt/homebrew/lib.
if [[ "$(uname)" == "Darwin" ]] && command -v brew &>/dev/null; then
  brew unlink --quiet libpng giflib jpeg-turbo libtiff xz zstd 2>/dev/null || true
fi
